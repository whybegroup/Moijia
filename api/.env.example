# Copy to `.env` in this folder (`cp .env.example .env`) and set values.
# `api/.env` is gitignored.

# Public site origin used in share-preview canonical URLs.
# PUBLIC_WEB_ORIGIN=https://moijia.com

# S3 file storage (required for uploads). Public links default to path-style
# https://s3.{S3_REGION}.amazonaws.com/{S3_BUCKET}/{key}
# (virtual-hosted HTTPS breaks when the bucket name contains dots).
# S3_BUCKET=
# S3_REGION=us-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CDN or custom public origin (no trailing slash).
# S3_PUBLIC_URL_BASE=https://s3.us-west-1.amazonaws.com/your-bucket
#
# Bucket CORS: allow PUT/OPTIONS from the app origin, AllowedHeaders *.
# Optional: send owner emails for the 15-day group downgrade grace period.
# MAIL_FROM=moijia <hello@moijia.com>
# RESEND_API_KEY=
# Use bucket-owner-enforced (no object ACLs).
