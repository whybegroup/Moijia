// Prisma Schema - Single source of truth for database
// Run: npm run db:migrate to create and apply migrations

datasource db {
  provider = "sqlite"
  url      = "file:./data/moijia.db"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// User Model
// ============================================

model User {
  id         String   @id @default(uuid())
  name       String
  displayName String
  avatarSeed String?  // DiceBear bottts seed for generated avatar
  thumbnail  String?  // Optional custom avatar image URL
  /// JSON: global in-app notification toggles (see NotifPrefs in API)
  notifPrefsJson String?
  /// JSON: ordered group ids for list / switcher UI (user preference)
  groupOrderJson String?
  /// Purchased extra owned-group slots beyond the 5 free Small groups.
  extraGroupSlots Int @default(0)
  /// Email from the auth provider, used for billing notices.
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  createdEvents           Event[]
  groupMemberships        GroupMember[]
  rsvps                   RSVP[]
  comments                Comment[]
  commentReactions        CommentReaction[]
  eventWatches            EventWatch[]
  authoredTimeSuggestions EventTimeSuggestion[] @relation("TimeSuggestionAuthor")
  createdPolls            Poll[]               @relation("PollCreator")
  closedPolls             Poll[]               @relation("PollCloser")
  pollOptionVotes         PollOptionVote[]
  pollTextAnswers         PollTextAnswer[]
  pollWatches             PollWatch[]
  pollOptionSuggestions   PollOptionSuggestion[]
  groupPosts              GroupPost[]
  groupPostReactions      GroupPostReaction[]
  groupPostComments       GroupPostComment[]
  groupPostCommentReactions GroupPostCommentReaction[]
  pushTokens              PushToken[]

  @@map("users")
}

// ============================================
// Group Models
// ============================================

model Group {
  id         String    @id @default(uuid())
  name       String
  desc       String
  announcement String?  // Group announcement visible to all members
  thumbnail  String?
  avatarSeed String?  // DiceBear icons seed for generated avatar
  inviteCode String?   @unique
  /// When true, new joins start as pending until an admin approves.
  requireApprovalToJoin Boolean @default(true)
  /// Max bytes this group may store in S3. Default Small = 1 GiB.
  maxStorageBytes String @default("1073741824")
  /// small | medium | large — source of storage and member caps.
  sizeTier String @default("small")
  /// Target tier after a cancelled/lapsed add-on (applied when graceEndsAt passes).
  pendingSizeTier String?
  graceEndsAt DateTime?
  graceNotifiedAt DateTime?
  /// RevenueCat product currently bound to this group's size add-on.
  sizeProductId String?
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  // Relations
  members     GroupMember[]
  events      Event[]
  coverPhotos GroupPhoto[]
  polls       Poll[]
  posts       GroupPost[]

  @@map("groups")
}

/// Tracks managed S3 uploads billed against a group's storage quota.
/// No FK: files may be uploaded with a client-generated group id before the group row exists.
model GroupStorageFile {
  id           String   @id @default(uuid())
  groupId      String
  objectKey    String   @unique
  publicUrl    String
  byteSize     Int
  originalName String?
  createdAt    DateTime @default(now())

  @@index([groupId])
  @@map("group_storage_files")
}

model GroupPost {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions GroupPostReaction[]
  comments  GroupPostComment[]

  @@index([groupId, createdAt])
  @@map("group_posts")
}

model GroupPostReaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@map("group_post_reactions")
}

model GroupPostComment {
  id              String   @id @default(uuid())
  postId          String
  userId          String
  body            String
  parentCommentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post      GroupPost           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    GroupPostComment?   @relation("GroupPostCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies   GroupPostComment[]  @relation("GroupPostCommentReplies")
  reactions GroupPostCommentReaction[]

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@map("group_post_comments")
}

model GroupPostCommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment GroupPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@map("group_post_comment_reactions")
}

model GroupPhoto {
  id        Int      @id @default(autoincrement())
  groupId   String
  photoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_photos")
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   String
  userId    String
  role      String   @default("member") // member, admin, owner
  status    String   @default("active") // pending, active, rejected
  colorHex  String?  // User's custom color for this group
  /// JSON: per-group notification toggles (AND with user global prefs)
  notifPrefsJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

// ============================================
// Event Models
// ============================================

model Event {
  id           String    @id @default(uuid())
  groupId      String
  createdBy    String
  updatedBy    String
  name         String
  description  String?
  start        DateTime
  end          DateTime
  isAllDay       Boolean?  @default(false)
  location       String?
  /// When true, the location string may be opened in maps. False for free-text / "use as entered".
  locationLinkable Boolean @default(true)
  /// Place display name when location came from Places (null for free-text).
  locationName     String?
  /// Full formatted address when location came from Places (null for free-text).
  locationAddress  String?
  minAttendees   Int?
  maxAttendees   Int?
  enableWaitlist Boolean?  @default(false)
  allowMaybe     Boolean   @default(true)
  /// When set, new/changed RSVPs are rejected after this instant (UTC). Null = no deadline.
  rsvpDeadline   DateTime?
  /// iCalendar RRULE line (same on every row in a series). Null on one-off events.
  recurrenceRule String?
  /// Shared id for all event rows created from one recurrence (null = not part of a series).
  recurrenceSeriesId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator     User         @relation(fields: [createdBy], references: [id])
  coverPhotos       EventPhoto[]
  rsvps             RSVP[]
  comments          Comment[]
  watches           EventWatch[]
  timeSuggestions   EventTimeSuggestion[]

  @@index([recurrenceSeriesId])
  @@map("events")
}

/// Group member proposes alternate start/end; host (or admin) may accept to update the event.
model EventTimeSuggestion {
  id          String   @id @default(uuid())
  eventId     String
  suggestedBy String
  start       DateTime
  end         DateTime
  status      String   @default("pending") // pending, accepted, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  suggester User  @relation("TimeSuggestionAuthor", fields: [suggestedBy], references: [id], onDelete: Cascade)

  @@map("event_time_suggestions")
}

model EventPhoto {
  id        Int      @id @default(autoincrement())
  eventId   String
  photoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_photos")
}

// ============================================
// RSVP Model
// ============================================

model RSVP {
  id        Int      @id @default(autoincrement())
  eventId   String
  userId    String
  status    String   @default("notGoing") // going, maybe, notGoing, waitlist
  memo      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("rsvps")
}

// Explicit watch/follow for event notifications (overrides default: host + going + maybe)
model EventWatch {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  watching  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_watches")
}

// ============================================
// Comment Models
// ============================================

model Comment {
  id        String         @id @default(uuid())
  eventId   String
  userId    String
  text      String?
  replyToCommentId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Relations
  event   Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id])
  photos  CommentPhoto[]
  reactions CommentReaction[]
  replyTo Comment?          @relation("CommentReplies", fields: [replyToCommentId], references: [id], onDelete: SetNull)
  replies Comment[]         @relation("CommentReplies")

  @@index([replyToCommentId])
  @@map("comments")
}

model CommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@map("comment_reactions")
}

model CommentPhoto {
  id        Int      @id @default(autoincrement())
  commentId String
  photoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@map("comment_photos")
}

// ============================================
// Poll (group poll — separate from event RSVPs)
// ============================================

model Poll {
  id               String   @id @default(uuid())
  groupId          String
  createdBy        String
  updatedBy        String
  title            String
  description      String?
  /// UTC instant when voting closes.
  deadline         DateTime?
  anonymousVotes   Boolean  @default(false)
  multipleChoice   Boolean  @default(false)
  ranking          Boolean  @default(false)
  closedAt         DateTime?
  closedBy         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group   Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User         @relation("PollCreator", fields: [createdBy], references: [id])
  closer User?        @relation("PollCloser", fields: [closedBy], references: [id])
  photos  PollPhoto[]
  options PollOption[]
  votes   PollOptionVote[]
  textAnswers PollTextAnswer[]
  watches PollWatch[]
  optionSuggestions PollOptionSuggestion[]

  @@map("polls")
}

// Explicit watch/follow for poll notifications (default: creator watches)
model PollWatch {
  id        String   @id @default(uuid())
  pollId    String
  userId    String
  watching  Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_watches")
}

model PollPhoto {
  id        Int      @id @default(autoincrement())
  pollId    String
  photoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@map("poll_photos")
}

/// One answer choice: either rich text (`inputKind` = text) or a single datetime.
model PollOption {
  id            String    @id @default(uuid())
  pollId        String
  sortOrder     Int
  /// "text" | "datetime"
  inputKind     String
  /// Sanitized HTML for text options; null when inputKind is datetime.
  textHtml      String?
  /// sans | serif | mono — applies to text option rendering.
  textFont      String?   @default("sans")
  /// UTC instant when inputKind is datetime.
  dateTimeValue DateTime?

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollOptionVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollOptionVote {
  id           String   @id @default(uuid())
  pollId       String
  pollOptionId String
  userId       String
  /// Ranking position for ranking-type questions (1 = best). Defaults to 1.
  rank         Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pollId, userId])
  @@unique([pollId, pollOptionId, userId])
  @@map("poll_option_votes")
}

model PollTextAnswer {
  id          String   @id @default(uuid())
  pollId      String
  questionKey String
  userId      String
  answer      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pollId, questionKey])
  @@unique([pollId, questionKey, userId])
  @@map("poll_text_answers")
}

/// Member-suggested choice labels pending creator review.
model PollOptionSuggestion {
  id          String    @id @default(uuid())
  pollId      String
  questionKey String
  label       String
  suggestedBy String
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  poll      Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  suggester User @relation(fields: [suggestedBy], references: [id], onDelete: Cascade)

  @@index([pollId, questionKey])
  @@index([pollId, status])
  @@map("poll_option_suggestions")
}

// ============================================
// Notification Model
// ============================================

model Notification {
  id         String   @id @default(uuid())
  type       String
  read       Boolean  @default(false)
  ts         DateTime @default(now())
  icon       String
  title      String
  body       String
  groupId    String?
  eventId    String?
  pollId     String?
  postId     String?
  commentId  String?
  navigable  Boolean  @default(false)
  dest       String?  // group, event, poll
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

// ============================================
// Push notification tokens (Expo)
// ============================================

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // ios | android
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
