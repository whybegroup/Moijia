# Backend API origin; OpenAPI base is this + /api (tsoa basePath)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Expo / EAS project UUID (Project settings in expo.dev) — required for iOS/Android push tokens
EXPO_PUBLIC_EAS_PROJECT_ID=

# Firebase Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Maps / Places (Text Search). Enable "Places API (New)" on the key's project.
# Falls back to EXPO_PUBLIC_FIREBASE_API_KEY_* when unset.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# RevenueCat public SDK keys. Test Store key is the default in code; set store-specific
# keys for App Store / Play / RevenueCat Billing in production.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_yZwTcJhfkgbkfOatxRovcSEgUdW
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
