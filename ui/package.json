{
  "name": "moijia-ui",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "nohup serve -s dist -l 8081 > ui.log 2>&1 &",
    "build": "expo export --platform web --clear",
    "android": "expo run:android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:install:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:signing": "./android/gradlew -p android :app:signingReport",
    "ios": "expo prebuild && expo run:ios",
    "ios:build": "expo prebuild && cd ios && pod install",
    "web": "expo start --web"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.0",
    "@dicebear/core": "^9.4.0",
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@firebase/auth": "1.10.8",
    "@moijia/client": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.0",
    "expo-audio": "~55.0.18",
    "expo-blur": "~55.0.10",
    "expo-build-properties": "~55.0.16",
    "expo-calendar": "~55.0.18",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.9",
    "expo-crypto": "^55.0.10",
    "expo-dev-client": "~55.0.35",
    "expo-device": "^55.0.10",
    "expo-document-picker": "^55.0.13",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.0",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.21",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.10",
    "firebase": "^11.3.0",
    "punycode": "^2.3.1",
    "react": "19.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^10.9.0",
    "react-native-purchases-ui": "^10.9.0",
    "react-native-reanimated": "4.2.1",
    "react-native-reorderable-list": "^0.18.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "react-redux": "^9.2.0",
    "reanimated-color-picker": "^4.2.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
